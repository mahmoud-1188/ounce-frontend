# عنوان الباك إند — بدون هذا المتغيّر يفترض الفرونت إند أن الباك إند
# يعمل محليًا على المنفذ 3001 (نفس منفذ تطوير الباك إند في هذا المشروع).
VITE_API_URL=http://localhost:3001/api

# ⚠ قيد مؤقت موثَّق: الفرونت إند الحالي بلا شاشة "اختيار الفرع" (بُني
# أصلًا على افتراض فرع واحد لكل نسخة تشغيل — راجع تعليق branchIdentity في
# GoldInventoryApp.jsx). شاشة الدخول تحتاج معرفة الفرع *قبل* تسجيل الدخول
# (لجلب قائمة الأسماء العامة)، فنستخدم هذا المعرّف الثابت مؤقتًا حتى تُبنى
# شاشة اختيار فرع حقيقية — وقتها هذا المتغيّر يُستبدَل باختيار المستخدم.
VITE_DEFAULT_BRANCH_ID=11111111-1111-1111-1111-111111111111
